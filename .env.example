# Shared secret between the proxy and the app. The proxy (Nginx Proxy Manager)
# sends it in the X-Proxy-Secret header on every request; with settings(auth=True)
# the app refuses every request without it, and refuses to start when it is empty.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
PROXY_SECRET=

# Signs the form token pages send on POST, PUT and DELETE. Must be at least 32 bytes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
