# Signing secret for login sessions. Must be at least 32 bytes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Microsoft login - only used when the app sets settings(auth=True, ssoDomains=[...]).
# From this app's own registration in Entra ID (Azure portal > App registrations).
# See docs/SignInForm.md for what to ask IT for.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: the date the client secret expires (YYYY-MM-DD). The server warns 30 days before.
MS_CLIENT_SECRET_EXPIRES=
